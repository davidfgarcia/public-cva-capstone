# Compliance agent: run-outcome emails
#
# One email is sent after every task run, scheduled or manual, saying whether it succeeded. When a run fails,
# fully or partially, the email describes each failure and links to the log files that show it.
# Format: YAML. Lines starting with # are comments. After editing, nothing needs restarting: each run reads this file.
# On AWS this file travels with the agent code (EC2: /opt/compliance-agent/notifications.config; Lambda: rebuild the
# image), see docs/installation.md, section 5.7.

enabled: true

# Who gets the emails. Add one address per line, each starting with "- ".
# to: the staff. A short email: one word (Success, Warning or Failure), then per project only what needs
#     looking at, in plain words, and where the files are.
to:
  - you@example.com
# admin_to: the administrator. The full email: every result, warning and failure, with links to the logs.
#     On AWS, also set by NOTIFY_ADMIN_TO in deploy/aws_config.env. Empty: no full email (the run log has it all).
admin_to: []
cc: []
#  - someone@example.com
bcc: []

# Sender. With Amazon SES this address (or its whole domain) must be verified in SES first (installation guide 5.7).
from: "Compliance Validation Agent <you@example.com>"
reply_to: []

subject_prefix: "[Compliance Validation Agent]"
# Times in the email are shown in this time zone, with UTC alongside
timezone: America/Los_Angeles

# all       = an email after every run (success too)
# problems  = only when a run fails, partly fails or doesn't start
send_on: all

# How the email is sent:
#   ses   Amazon Simple Email Service, using the AWS role of the EC2 instance / Lambda function, or the AWS
#         credentials of the computer running the desktop app
#   smtp  any SMTP server (Google Workspace, Microsoft 365, ...): fill in the smtp section
#   none  don't send emails
transport: ses

ses:
  region: ""                     # region where the sender is verified in SES; empty: the server's own region
                                 # (AWS_DEFAULT_REGION in /etc/compliance-agent/env, us-east-2)
  configuration_set: ""          # optional SES configuration set (delivery tracking)

smtp:
  host: ""                       # e.g. smtp.gmail.com (Google Workspace) or smtp.office365.com
  port: 587
  security: starttls             # starttls | ssl | none
  username: ""
  password_env: SMTP_PASSWORD    # environment variable holding the password (e.g. a Google app password), or
  password_secret: ""            # name of an AWS Secrets Manager secret holding it

# Links to log files in the email.
links:
  google_drive: true             # links to the staff's own copy of each file (runs on AWS; never the AWS-side copy)
  local_paths: true              # file links for runs on a staff computer (they open on that computer)

# Attach the relevant CSV logs as well: all | problems | never
attach_logs: problems
# attach_logs_on_aws: false   # emails sent from AWS link to the logs instead: attached there, they would show tokens
max_attachments_mb: 8
max_issues_listed: 50            # longer lists are cut in the email; the logs have everything
